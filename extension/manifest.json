{
  "manifest_version": 3,
  "name": "cctabgaze",
  "version": "0.1.0",
  "key": "",
  "description": "在另一台電腦的 Chrome 旁觀這台 Chrome 裡 AI 正在操作的分頁，並可從這台操作（WebRTC 經 Tailscale 直連）",
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "action": {
    "default_title": "cctabgaze",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
