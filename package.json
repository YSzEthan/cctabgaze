{
  "name": "cctabgaze",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:web": "bun build web/app.ts --outfile web/app.js --target browser",
    "watch": "tsc --watch",
    "check": "tsc --noEmit && tsc -p test && tsc -p server && tsc -p web",
    "test": "node test/rtc.test.ts && node test/relay.test.ts",
    "e2e": "tsc && node test/e2e.ts",
    "e2e:signal": "tsc && node test/e2e-signal.ts",
    "bump": "node scripts/bump.ts",
    "pack": "tsc && scripts/pack.sh cctabgaze.zip"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  }
}
