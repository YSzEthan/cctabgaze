{
  "manifest_version": 3,
  "name": "cctabgaze proto-B",
  "version": "0.0.5",
  "description": "原型：驗證兩個插件用 chrome.storage.sync 交換連線資訊後，經 Tailscale 建立 WebRTC 點對點連線",
  "key": "",
  "permissions": [
    "storage",
    "offscreen",
    "tabGroups"
  ],
  "action": {
    "default_title": "開啟 proto-B 面板"
  },
  "background": {
    "service_worker": "background.js"
  }
}
